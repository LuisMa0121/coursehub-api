# Puerto del servidor
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Conexión principal a PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-your-local-password
DATABASE_NAME=coursehub

# Variables alternativas compatibles (Sesión 13 y 14)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=replace-with-your-local-password
# DB_NAME=coursehub

# Control de sincronización de TypeORM:
# En desarrollo: true | false (con false se usan migraciones versionadas)
# En producción: se desactiva estrictamente de forma automática (false)
DATABASE_SYNCHRONIZE=false

# Configuración de Autenticación JWT
JWT_SECRET=super_secret_jwt_key_para_desarrollo_cambiar_en_produccion
JWT_EXPIRES_IN=1d
