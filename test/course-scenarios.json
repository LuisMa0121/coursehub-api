      {
        "id": 3
      }
    ],
    "length": 1
  },
  {
    "name": "Filtro sin coincidencias",
    "method": "GET",
    "route": "/courses?level=advanced",
    "status": 200,
    "expected": [],
    "length": 0
  },
  {
    "name": "Crear curso con DTO",
    "method": "POST",
    "route": "/courses",
    "status": 201,
    "body": {
      "title": "Testing NestJS",
      "level": "intermediate"
    },
    "expected": {
      "id": 4,
      "title": "Testing NestJS",
      "level": "intermediate"
    }
  },
  {
    "name": "Rechazar título vacío",
