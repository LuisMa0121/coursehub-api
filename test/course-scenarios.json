    "status": 400,
    "body": {
      "id": 100
    }
  },
  {
    "name": "Rechazar título nulo",
    "method": "PATCH",
    "route": "/courses/4",
    "status": 400,
    "body": {
      "title": null
    }
  },
  {
    "name": "Error de validación conserva el curso",
    "method": "GET",
    "route": "/courses/4",
    "status": 200,
    "expected": {
      "id": 4,
      "title": "Testing APIs with NestJS",
      "level": "advanced"
    }
  },
  {
    "name": "Consultar curso inexistente",
    "method": "GET",
    "route": "/courses/999",
    "status": 404
  },
  {
    "name": "Actualizar curso inexistente",
    "method": "PATCH",
    "route": "/courses/999",
    "status": 404,
    "body": {
      "title": "Otro"
    }
  },
  {
    "name": "Eliminar curso inexistente",
    "method": "DELETE",
    "route": "/courses/999",
    "status": 404
  },
  {
    "name": "Eliminar curso existente",
    "method": "DELETE",
    "route": "/courses/4",
    "status": 200,
    "expected": {
      "id": 4,
      "title": "Testing APIs with NestJS",
      "level": "advanced"
    }
  },
  {
    "name": "Consultar tras eliminar",
    "method": "GET",
    "route": "/courses/4",
    "status": 404
  },
  {
    "name": "Eliminar por segunda vez",
    "method": "DELETE",
    "route": "/courses/4",
    "status": 404
  },
  {
    "name": "Contador no reutiliza id eliminado",
    "method": "POST",
    "route": "/courses",
    "status": 201,
    "body": {
      "title": "Diseño de APIs",
      "level": "beginner"
    },
    "expected": {
      "id": 5,
      "title": "Diseño de APIs",
      "level": "beginner"
    }
  },
  {
    "name": "Actualizar parcialmente con objeto vacío",
    "method": "PATCH",
    "route": "/courses/5",
    "status": 200,
    "body": {},
    "expected": {
      "id": 5,
      "title": "Diseño de APIs",
      "level": "beginner"
    }
  }
