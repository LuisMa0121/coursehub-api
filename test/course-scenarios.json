    }
  },
  {
    "name": "Rechazar cuerpo vacío",
    "method": "POST",
    "route": "/courses",
    "status": 400,
    "body": {}
  },
  {
    "name": "Rechazar propiedad extra",
    "method": "POST",
    "route": "/courses",
    "status": 400,
    "body": {
      "title": "Prueba",
      "level": "beginner",
      "duration": 20
    }
  },
  {
    "name": "Cambiar solo el título",
    "method": "PATCH",
    "route": "/courses/4",
    "status": 200,
    "body": {
      "title": "Testing APIs with NestJS"
    },
    "expected": {
      "id": 4,
      "title": "Testing APIs with NestJS",
      "level": "intermediate"
    }
  },
  {
    "name": "Cambiar solo el nivel",
    "method": "PATCH",
    "route": "/courses/4",
    "status": 200,
    "body": {
      "level": "advanced"
    },
    "expected": {
      "id": 4,
      "title": "Testing APIs with NestJS",
      "level": "advanced"
    }
  },
  {
    "name": "Rechazar nivel inválido al actualizar",
    "method": "PATCH",
    "route": "/courses/4",
    "status": 400,
    "body": {
      "level": "expert"
    }
  },
  {
    "name": "Rechazar cambio de identificador",
    "method": "PATCH",
